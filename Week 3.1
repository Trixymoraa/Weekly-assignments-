#include <stdio.h>

int main() {
	
	float attendance, marks;
	
	printf("Enter attendance: \t");
	scanf("%f",&attendance);
	
	printf("Enter marks out of 100: \t");
	scanf("%f",&marks);
	
	if (attendance >= 75 && marks >= 40){
		printf("Eligible for the exams\n");
	}
	else{
		printf("Not eligible for the exams\n");
	}
	return 0;
}
